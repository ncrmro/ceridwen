{
  "name": "ceridwen-cad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4310",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "export": "node --import tsx scripts/export.ts",
    "build": "npm run check && npm run test && npm run export && vite build",
    "release:check": "node --import tsx scripts/export.ts --release"
  },
  "dependencies": {
    "replicad": "0.19.0",
    "replicad-opencascadejs": "0.19.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
